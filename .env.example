# ───────── 필수 ─────────
# PostgreSQL 접속 주소 (Supabase: 프로젝트 설정 → Database → Connection string)
DATABASE_URL=postgres://apton:apton_dev@localhost:5432/apton

# 서비스 주소 (문자 속 공지 링크에 사용). 배포 후 실제 주소로 변경
APP_URL=http://localhost:3000

# 전화번호 암호화 키 (32바이트, base64). 생성: openssl rand -base64 32
# ⚠ 한 번 정하면 바꾸지 마세요. 바꾸면 저장된 전화번호를 복호화할 수 없습니다.
DATA_ENCRYPTION_KEY=

# 관리자 가입 코드. 첫 관리자 이후 새 아파트·관리자 가입 시 필요 (외부인 무단 가입 → 문자비 발생 방지)
ADMIN_SIGNUP_CODE=

# 예약 발송 실행 엔드포인트 보호용 비밀값. 생성: openssl rand -hex 24
CRON_SECRET=

# ───────── 실제 문자 발송 (SOLAPI) ─────────
# 비워두면 모든 아파트가 '테스트 모드'로만 동작합니다 (실제 발송·과금 없음)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=

# ───────── 예약 발송 실행 방식 ─────────
# internal: `npm start`로 띄운 서버가 30초마다 예약 발송을 직접 처리 (자체 서버/Docker)
# off: 외부 크론(Supabase pg_cron, cron-job.org 등)이 /api/cron/dispatch 를 1분마다 호출 (Vercel)
SCHEDULER=internal

# ───────── 선택: AI 공지 작성 보조 ─────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
